{
  "name": "ustvalley",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "maps:build": "tsx scripts/build-maps.ts",
    "maps:verify": "tsx scripts/build-maps.ts --check",
    "maps:release": "tsx scripts/build-maps.ts --check --strict",
    "dev": "npm run maps:build && vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "build": "npm run maps:verify && npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "maps:unpack": "tsx scripts/unpack-maps.ts",
    "maps:inspect": "tsx scripts/inspect-floors.ts",
    "maps:orbit": "tsx scripts/build-orbit.ts",
    "photos:serve": "tsx src/server/photo-main.ts",
    "photos:admin": "tsx scripts/photo-admin.ts",
    "test:photos": "tsx --test tests/photos/*.test.ts",
    "photo-rebuild": "tsx scripts/photo-rebuild.ts",
    "test:photos:e2e": "playwright test --config playwright.photos.config.ts"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "better-sqlite3": "^13.0.3",
    "busboy": "^1.6.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "heic-decode": "^2.1.0",
    "phaser": "3.90.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.5",
    "three": "0.187.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/busboy": "^1.5.5",
    "@types/express": "^5.0.6",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.187.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "polygon-clipping": "0.15.7",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "overrides": {
    "vite": {
      "esbuild": "0.28.2"
    }
  }
}
